#!/usr/bin/env bash
# petcam launcher: opens the remote-feed window under the pet (float + borderless
# via the hyprland.lua window rule "petcam-screen").
# Usage: petcam-feed [width height x y]   (defaults 480x270, parked under the
# pet on DP-1)
#
# WHY DISPATCH RATHER THAN mpv --geometry:
#   Hyprland (via Omarchy's hl.* shim) ignores client-requested geometry on
#   Wayland, so we place the window AFTER it maps, using hl.dsp.window.move /
#   .resize dispatches. The float+border rule in hyprland.lua keeps it a
#   small borderless pane; this script only positions + (re)focuses it.
# WHY MOUSE BUTTONS ARE NEUTRALIZED IN input.conf:
#   The feed window is NOT the score target (that's the pet's spot -> /control
#   -> the mark's machine). A real mouse click on the pane must not hit mpv's
#   default bindings (fullscreen/pause), so the conf maps buttons to `ignore`.
# WHY RE-OPEN INSTEAD OF STACK:
#   Running the launcher a second time focuses the existing window rather than
#   spawning a second mpv (title match via hyprctl -j clients).
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
W="${1:-480}"; H="${2:-270}"; X="${3:-2064}"; Y="${4:-890}"
SRC="${PETCAM_SRC:-http://192.0.2.10:9101/stream.mjpeg}"
printf '%s\n' 'q quit' 'ESC quit' 'MOUSE_BTN0 ignore' 'MOUSE_BTN1 ignore' 'MOUSE_BTN2 ignore' 'MOUSE_BTN3 ignore' 'MOUSE_BTN4 ignore' 'MOUSE_BTN5 ignore' > "$HERE/input.conf"
addr() {
  hyprctl -j clients 2>/dev/null | python3 -c '
import json,sys
for c in json.load(sys.stdin):
    if c.get("title") == "petcam":
        print(c["address"]); break' 2>/dev/null
}
# Re-open instead of stacking: focus existing petcam window if present
existing=$(addr)
if [ -n "$existing" ]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$existing\" })" >/dev/null 2>&1
    exit 0
fi
# mpv's --geometry is ignored on Wayland here; place via dispatchers after map.
mpv --title=petcam --keep-open=yes --input-conf="$HERE/input.conf" \
  --no-border "$SRC" &
MPID=$!
for i in $(seq 1 25); do
    a=$(addr)
    [ -n "$a" ] && break
    kill -0 "$MPID" 2>/dev/null || break
    sleep 0.2
done
hyprctl dispatch "hl.dsp.window.resize({ x = $W, y = $H })" >/dev/null 2>&1
hyprctl dispatch "hl.dsp.window.move({ x = $X, y = $Y })" >/dev/null 2>&1
wait "$MPID"
